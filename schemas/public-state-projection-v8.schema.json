{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/public-state-projection-v8.schema.json",
  "title": "lean-eval public State projection schema version 8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "source_state_commit",
    "source_event_count",
    "source_digest",
    "results",
    "result_overlays",
    "model_identities",
    "model_aliases",
    "model_identity_history",
    "result_amendment_history",
    "historical_replay_series",
    "historical_replay_unavailability",
    "acceptance_measurements",
    "metadata_provenance"
  ],
  "properties": {
    "environment": {
      "$ref": "public-state-projection-v6.schema.json#/properties/environment"
    },
    "source_state_commit": {
      "$ref": "public-state-projection-v6.schema.json#/properties/source_state_commit"
    },
    "source_event_count": {
      "$ref": "public-state-projection-v6.schema.json#/properties/source_event_count"
    },
    "source_digest": {
      "$ref": "public-state-projection-v6.schema.json#/properties/source_digest"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "result_overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "model_identities": {
      "$ref": "public-state-projection-v6.schema.json#/properties/model_identities"
    },
    "model_aliases": {
      "$ref": "public-state-projection-v6.schema.json#/properties/model_aliases"
    },
    "model_identity_history": {
      "$ref": "public-state-projection-v6.schema.json#/properties/model_identity_history"
    },
    "result_amendment_history": {
      "$ref": "public-state-projection-v6.schema.json#/properties/result_amendment_history"
    },
    "historical_replay_series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/replaySeries"
      }
    },
    "historical_replay_unavailability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unavailability"
      }
    },
    "schema_version": {
      "const": 8
    },
    "acceptance_measurements": {
      "type": "array",
      "items": {
        "$ref": "acceptance-measurement-v1.schema.json"
      }
    },
    "metadata_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "fields"
        ],
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^r2_[0-9a-f]{64}$"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "credit_identity",
                "component_models",
                "harness",
                "human_involvement",
                "web_access",
                "wall_time_seconds",
                "input_tokens",
                "output_tokens",
                "cost_usd",
                "billing_mode",
                "prompt",
                "notes",
                "cached_input_tokens"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "recorded_at",
                "initial"
              ],
              "properties": {
                "event_id": {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/eventId"
                },
                "recorded_at": {
                  "$ref": "public-state-projection-v4.schema.json#/$defs/timestamp"
                },
                "initial": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "problem_id",
        "statement_revision",
        "declared_model",
        "submitter",
        "accepted_at",
        "acceptance_event_id",
        "recorded_at",
        "record_event_id",
        "benchmark_commit",
        "production_metadata",
        "replay",
        "release",
        "public_solution",
        "model_id",
        "resolved_model_id",
        "effective_problem_id",
        "effective_statement_revision",
        "problem_repair",
        "applied_problem_repair",
        "retraction",
        "leaderboard_eligible"
      ],
      "properties": {
        "result_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/result_id"
        },
        "problem_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/problem_id"
        },
        "statement_revision": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/statement_revision"
        },
        "declared_model": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/declared_model"
        },
        "submitter": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/submitter"
        },
        "accepted_at": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/accepted_at"
        },
        "acceptance_event_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/acceptance_event_id"
        },
        "recorded_at": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/recorded_at"
        },
        "record_event_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/record_event_id"
        },
        "benchmark_commit": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/benchmark_commit"
        },
        "production_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credit_identity": {
              "allOf": [
                {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                },
                {
                  "maxLength": 256
                }
              ]
            },
            "component_models": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "allOf": [
                  {
                    "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                  },
                  {
                    "maxLength": 256
                  }
                ]
              }
            },
            "harness": {
              "allOf": [
                {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                },
                {
                  "maxLength": 1024
                }
              ]
            },
            "human_involvement": {
              "allOf": [
                {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                },
                {
                  "maxLength": 1024
                }
              ]
            },
            "web_access": {
              "type": "boolean"
            },
            "wall_time_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 31536000
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "billing_mode": {
              "enum": [
                "api",
                "subscription",
                "unknown"
              ]
            },
            "prompt": {
              "allOf": [
                {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                },
                {
                  "maxLength": 8192
                }
              ]
            },
            "notes": {
              "allOf": [
                {
                  "$ref": "public-state-projection-v1.schema.json#/$defs/metadataText"
                },
                {
                  "maxLength": 4096
                }
              ]
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "replay": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/replay"
        },
        "release": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/release"
        },
        "public_solution": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/public_solution"
        },
        "model_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/model_id"
        },
        "resolved_model_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/resolved_model_id"
        },
        "effective_problem_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/effective_problem_id"
        },
        "effective_statement_revision": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/effective_statement_revision"
        },
        "problem_repair": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/problem_repair"
        },
        "applied_problem_repair": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/applied_problem_repair"
        },
        "retraction": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/retraction"
        },
        "leaderboard_eligible": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/leaderboard_eligible"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "owner_login",
        "declared_model",
        "problem_id",
        "statement_revision",
        "claim_event_id",
        "mutation_event_id",
        "claimed_at",
        "metadata",
        "model_id",
        "resolved_model_id",
        "effective_problem_id",
        "effective_statement_revision",
        "problem_repair",
        "applied_problem_repair",
        "retraction",
        "leaderboard_eligible"
      ],
      "properties": {
        "result_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/result_id"
        },
        "owner_login": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/owner_login"
        },
        "declared_model": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/declared_model"
        },
        "problem_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/problem_id"
        },
        "statement_revision": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/statement_revision"
        },
        "claim_event_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/claim_event_id"
        },
        "mutation_event_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/mutation_event_id"
        },
        "claimed_at": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/claimed_at"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "credit_identity": {
              "$ref": "result-overlays-v1.schema.json#/$defs/text256Provenance"
            },
            "component_models": {
              "$ref": "result-overlays-v1.schema.json#/$defs/componentModelsProvenance"
            },
            "harness": {
              "$ref": "result-overlays-v1.schema.json#/$defs/text1024Provenance"
            },
            "human_involvement": {
              "$ref": "result-overlays-v1.schema.json#/$defs/text1024Provenance"
            },
            "web_access": {
              "$ref": "result-overlays-v1.schema.json#/$defs/booleanProvenance"
            },
            "wall_time_seconds": {
              "$ref": "result-overlays-v1.schema.json#/$defs/wallTimeProvenance"
            },
            "input_tokens": {
              "$ref": "result-overlays-v1.schema.json#/$defs/tokenProvenance"
            },
            "output_tokens": {
              "$ref": "result-overlays-v1.schema.json#/$defs/tokenProvenance"
            },
            "cost_usd": {
              "$ref": "result-overlays-v1.schema.json#/$defs/costProvenance"
            },
            "billing_mode": {
              "$ref": "result-overlays-v1.schema.json#/$defs/billingProvenance"
            },
            "prompt": {
              "$ref": "result-overlays-v1.schema.json#/$defs/text8192Provenance"
            },
            "notes": {
              "$ref": "result-overlays-v1.schema.json#/$defs/text4096Provenance"
            },
            "cached_input_tokens": {
              "$ref": "result-overlays-v1.schema.json#/$defs/tokenProvenance"
            }
          }
        },
        "model_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/model_id"
        },
        "resolved_model_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/resolved_model_id"
        },
        "effective_problem_id": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/effective_problem_id"
        },
        "effective_statement_revision": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/effective_statement_revision"
        },
        "problem_repair": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/problem_repair"
        },
        "applied_problem_repair": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/applied_problem_repair"
        },
        "retraction": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/retraction"
        },
        "leaderboard_eligible": {
          "$ref": "public-state-projection-v5.schema.json#/$defs/overlay/properties/leaderboard_eligible"
        }
      }
    },
    "historicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identityProperties": {
      "result_id": {
        "$ref": "public-state-projection-v5.schema.json#/$defs/result/properties/result_id"
      },
      "owner_login": {
        "$ref": "public-state-projection-v4.schema.json#/$defs/login"
      },
      "declared_model": {
        "$ref": "public-state-projection-v4.schema.json#/$defs/label"
      },
      "problem_id": {
        "$ref": "public-state-projection-v5.schema.json#/$defs/problemId"
      },
      "statement_revision": {
        "$ref": "public-state-projection-v5.schema.json#/$defs/positive"
      },
      "historical_accepted_at": {
        "$ref": "#/$defs/historicalTimestamp"
      },
      "source_visibility": {
        "enum": [
          "public",
          "private"
        ]
      }
    },
    "replaySeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "owner_login",
        "declared_model",
        "problem_id",
        "statement_revision",
        "historical_accepted_at",
        "source_visibility",
        "replay_task_id",
        "measurement_config_digest",
        "execution_profile_digest",
        "transition_event_id",
        "updated_at",
        "replay",
        "fetch_method"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/identityProperties/result_id"
        },
        "owner_login": {
          "$ref": "#/$defs/identityProperties/owner_login"
        },
        "declared_model": {
          "$ref": "#/$defs/identityProperties/declared_model"
        },
        "problem_id": {
          "$ref": "#/$defs/identityProperties/problem_id"
        },
        "statement_revision": {
          "$ref": "#/$defs/identityProperties/statement_revision"
        },
        "historical_accepted_at": {
          "$ref": "#/$defs/identityProperties/historical_accepted_at"
        },
        "source_visibility": {
          "$ref": "#/$defs/identityProperties/source_visibility"
        },
        "replay_task_id": {
          "type": "string",
          "pattern": "^rt1_[0-9a-f]{64}$"
        },
        "measurement_config_digest": {
          "$ref": "public-state-projection-v1.schema.json#/$defs/digest"
        },
        "execution_profile_digest": {
          "$ref": "public-state-projection-v1.schema.json#/$defs/digest"
        },
        "transition_event_id": {
          "$ref": "public-state-projection-v1.schema.json#/$defs/eventId"
        },
        "updated_at": {
          "$ref": "public-state-projection-v4.schema.json#/$defs/timestamp"
        },
        "replay": {
          "$ref": "public-state-projection-v1.schema.json#/$defs/replay"
        },
        "fetch_method": {
          "enum": [
            "git",
            "archive"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_visibility": {
                "const": "private"
              }
            }
          },
          "then": {
            "properties": {
              "fetch_method": {
                "const": "archive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fetch_method": {
                "const": "archive"
              },
              "source_visibility": {
                "const": "public"
              }
            }
          },
          "then": {
            "properties": {
              "replay": {
                "properties": {
                  "reason": {
                    "not": {
                      "const": "source_ref_permanently_unavailable"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay": {
                "properties": {
                  "reason": {
                    "const": "archive_permanently_unrecoverable"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fetch_method": {
                "const": "archive"
              }
            }
          }
        }
      ]
    },
    "unavailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "owner_login",
        "declared_model",
        "problem_id",
        "statement_revision",
        "historical_accepted_at",
        "source_visibility",
        "disposition_event_id",
        "disposed_at",
        "reason",
        "rationale",
        "fetch_method"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/identityProperties/result_id"
        },
        "owner_login": {
          "$ref": "#/$defs/identityProperties/owner_login"
        },
        "declared_model": {
          "$ref": "#/$defs/identityProperties/declared_model"
        },
        "problem_id": {
          "$ref": "#/$defs/identityProperties/problem_id"
        },
        "statement_revision": {
          "$ref": "#/$defs/identityProperties/statement_revision"
        },
        "historical_accepted_at": {
          "$ref": "#/$defs/identityProperties/historical_accepted_at"
        },
        "source_visibility": {
          "$ref": "#/$defs/identityProperties/source_visibility"
        },
        "disposition_event_id": {
          "$ref": "public-state-projection-v1.schema.json#/$defs/eventId"
        },
        "disposed_at": {
          "$ref": "public-state-projection-v4.schema.json#/$defs/timestamp"
        },
        "reason": {
          "enum": [
            "source_ref_permanently_unavailable",
            "archive_not_found",
            "archive_permanently_unrecoverable"
          ]
        },
        "rationale": {
          "oneOf": [
            {
              "const": "accepted_immutable_source_ref_unavailable_without_archive"
            },
            {
              "type": "null"
            },
            {
              "const": "accepted_archive_permanently_unrecoverable_after_review"
            }
          ]
        },
        "fetch_method": {
          "enum": [
            "git",
            "archive"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "archive_permanently_unrecoverable"
              }
            }
          },
          "then": {
            "properties": {
              "fetch_method": {
                "const": "archive"
              },
              "rationale": {
                "const": "accepted_archive_permanently_unrecoverable_after_review"
              }
            }
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source_visibility": {
                      "const": "public"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "source_ref_permanently_unavailable"
                    },
                    "rationale": {
                      "const": "accepted_immutable_source_ref_unavailable_without_archive"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reason": {
                      "const": "archive_not_found"
                    },
                    "rationale": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "source_visibility": {
                      "const": "public"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "fetch_method": {
                      "const": "git"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "fetch_method": {
                      "const": "archive"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
