{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/public-state-projection-v1.schema.json",
  "title": "LeanEval public State projection schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment", "source_state_commit",
    "source_event_count", "source_digest", "results"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["production", "staging"] },
    "source_state_commit": { "$ref": "#/$defs/commit" },
    "source_event_count": { "type": "integer", "minimum": 1 },
    "source_digest": { "$ref": "#/$defs/digest" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullableText": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "nullableNatural": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "metadataText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "productionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit_identity": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
        },
        "component_models": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 256 }]
          }
        },
        "harness": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "human_involvement": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 1024 }]
        },
        "web_access": { "type": "boolean" },
        "wall_time_seconds": { "type": "number", "minimum": 0, "maximum": 31536000 },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cost_usd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "billing_mode": { "enum": ["api", "subscription", "unknown"] },
        "prompt": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 8192 }]
        },
        "notes": {
          "allOf": [{ "$ref": "#/$defs/metadataText" }, { "maxLength": 4096 }]
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "attempt", "checker", "checker_wall_time_ms",
        "checker_retired_instructions", "checker_retired_instructions_unavailable_reason",
        "build_wall_time_ms", "build_retired_instructions",
        "build_retired_instructions_unavailable_reason", "lines_of_code", "file_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "queued", "running", "accepted", "rejected", "declined", "crashed",
            "timed_out", "failed", "unavailable"
          ]
        },
        "reason": { "$ref": "#/$defs/nullableText" },
        "attempt": { "type": "integer", "minimum": 0 },
        "checker": { "$ref": "#/$defs/nullableText" },
        "checker_wall_time_ms": { "$ref": "#/$defs/nullableNatural" },
        "checker_retired_instructions": { "$ref": "#/$defs/nullableNatural" },
        "checker_retired_instructions_unavailable_reason": { "$ref": "#/$defs/nullableText" },
        "build_wall_time_ms": { "$ref": "#/$defs/nullableNatural" },
        "build_retired_instructions": { "$ref": "#/$defs/nullableNatural" },
        "build_retired_instructions_unavailable_reason": { "$ref": "#/$defs/nullableText" },
        "lines_of_code": { "$ref": "#/$defs/nullableNatural" },
        "file_count": { "$ref": "#/$defs/nullableNatural" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "release_at", "reason"],
      "properties": {
        "status": { "enum": ["scheduled", "running", "published", "failed", "cancelled"] },
        "release_at": { "$ref": "#/$defs/nullableText" },
        "reason": { "$ref": "#/$defs/nullableText" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id", "problem_id", "statement_revision", "declared_model", "submitter",
        "accepted_at", "acceptance_event_id", "recorded_at", "record_event_id",
        "benchmark_commit", "production_metadata", "replay", "release", "public_solution"
      ],
      "properties": {
        "result_id": { "type": "string", "pattern": "^r2_[0-9a-f]{64}$" },
        "problem_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "statement_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "declared_model": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "submitter": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "accepted_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "acceptance_event_id": { "$ref": "#/$defs/eventId" },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "record_event_id": { "$ref": "#/$defs/eventId" },
        "benchmark_commit": { "$ref": "#/$defs/commit" },
        "production_metadata": { "$ref": "#/$defs/productionMetadata" },
        "replay": { "oneOf": [{ "$ref": "#/$defs/replay" }, { "type": "null" }] },
        "release": { "oneOf": [{ "$ref": "#/$defs/release" }, { "type": "null" }] },
        "public_solution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "url"],
          "properties": {
            "available": { "type": "boolean" },
            "url": { "$ref": "#/$defs/nullableText" }
          }
        }
      }
    }
  }
}
