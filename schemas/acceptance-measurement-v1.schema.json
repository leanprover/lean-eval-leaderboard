{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-lang.org/schemas/lean-eval/acceptance-measurement-v1.schema.json",
  "title": "LeanEval acceptance build measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "result_id",
    "owner_login",
    "declared_model",
    "problem_id",
    "statement_revision",
    "benchmark_commit",
    "results_commit",
    "toolchain",
    "series",
    "attempt",
    "workflow_run_id",
    "workflow_commit",
    "measured_at",
    "runner_class",
    "architecture",
    "cache_state",
    "components",
    "status",
    "reason_code",
    "build_wall_time_ms",
    "build_retired_instructions",
    "build_retired_instructions_unavailable_reason",
    "checker_wall_time_ms",
    "checker_retired_instructions",
    "checker_retired_instructions_unavailable_reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "acceptance-build"
    },
    "result_id": {
      "type": "string",
      "pattern": "^r2_[0-9a-f]{64}$"
    },
    "owner_login": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
    },
    "declared_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "statement_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "benchmark_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "results_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "toolchain": {
      "type": "string",
      "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:rc|beta)[0-9]+)?$"
    },
    "series": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workflow_run_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workflow_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "measured_at": {
      "type": "string",
      "pattern": "^(?!0000-)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "runner_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "cache_state": {
      "const": "solution-cold-dependencies-cached"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparator",
        "lean4export",
        "nanoda",
        "landrun"
      ],
      "properties": {
        "comparator": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lean4export": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "nanoda": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "landrun": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "status": {
      "enum": [
        "available",
        "failed"
      ]
    },
    "reason_code": {
      "enum": [
        null,
        "measurement_unavailable",
        "measurement_invalid"
      ]
    },
    "build_wall_time_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "build_retired_instructions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "build_retired_instructions_unavailable_reason": {
      "enum": [
        null,
        "counter_not_supported",
        "counter_permission_denied",
        "counter_not_reported"
      ]
    },
    "checker_wall_time_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checker_retired_instructions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checker_retired_instructions_unavailable_reason": {
      "enum": [
        null,
        "counter_not_supported",
        "counter_permission_denied",
        "counter_not_reported"
      ]
    }
  }
}
